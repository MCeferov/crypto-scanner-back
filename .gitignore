# dependencies
node_modules

# build output
dist
*.tsbuildinfo

# env — never commit real secrets; .env.example is the template.
# Deny every .env* variant and re-allow only the template: the previous list
# named .env and .env.*.local specifically, which left .env.production and
# .env.development one `git add .` away from being committed.
.env*
!.env.example

# local credential drops
*.pem
*.key
*.p12
secrets.json

# prisma generated client
/prisma/generated

# editors
/.idea
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# logs
npm-debug.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db
