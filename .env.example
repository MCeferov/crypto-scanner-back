# ─── Database (PostgreSQL — Neon / Supabase / Railway) ────────────
# Neon and Supabase require ?sslmode=require. Read by BOTH the server
# (src/env.ts) and the Prisma CLI (prisma.config.ts), so they can never
# disagree about which database they are talking to.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# ─── Auth ─────────────────────────────────────────────────────────
# Must be at least 32 characters — the server refuses to boot otherwise.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-to-a-random-string-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# ─── CORS ─────────────────────────────────────────────────────────
# Comma-separated allowlist of frontend origins. REQUIRED in production —
# the server refuses to boot without it, because the SPA lives on another
# origin and CORS is the only access control in front of this API.
# Local dev: leave empty to reflect any origin.
# Production: FRONTEND_URL="https://crypto-heatmap.netlify.app"
FRONTEND_URL=""

# ─── Server ───────────────────────────────────────────────────────
# Railway injects PORT automatically — do not set it there.
PORT=3000
NODE_ENV=development

# ─── Market data ──────────────────────────────────────────────────
# api.binance.com answers HTTP 451 to US and many datacenter IPs.
# data-api.binance.vision is the official public market-data host and is the
# safer choice for cloud deployments — this app only uses public endpoints.
# The Railway service must still run in an EU region.
BINANCE_API_BASE="https://data-api.binance.vision/api/v3"

# Optional — falls back to an in-process memory cache when unset.
REDIS_URL=""
# ALPHA_VANTAGE_API_KEY=""
# FMP_API_KEY=""

# ─── Proxy trust ──────────────────────────────────────────────────
# How many reverse proxies sit in front of this process. This is a
# SECURITY setting, not a formatting one: every IP-keyed control
# (rate limits, abuse logging) reads req.ip, and req.ip is derived
# from X-Forwarded-For. Set this HIGHER than the real number of
# proxies and a client can forge its own address by sending the
# header itself, which silently disables those controls.
# Railway = 1. Direct/no proxy = false. Verify after deploying, see
# README "Verifying trust proxy".
TRUST_PROXY=1

# ─── Rate limits (all optional — defaults shown) ──────────────────
# Per-client budgets are the first line; the *_GLOBAL_MAX ceilings
# are the backstop that still holds when a client rotates its IP.
# API_RATE_MAX=300              # per client / API_RATE_WINDOW_SECONDS, all /api
# API_RATE_WINDOW_SECONDS=60
# AUTH_RATE_MAX=10              # login, per client / 15 min
# AUTH_RATE_WINDOW_SECONDS=900
# AUTH_RATE_GLOBAL_MAX=600      # login, all clients combined
# SIGNUP_RATE_MAX=5             # signup, per client / 1 hour
# SIGNUP_RATE_WINDOW_SECONDS=3600
# SIGNUP_RATE_GLOBAL_MAX=100
# MARKET_RATE_MAX=120           # quote endpoints, per client / min
# KLINE_RATE_MAX=60             # kline endpoints, per client / min
# KLINE_RATE_GLOBAL_MAX=600
# BINANCE_PROXY_MAX=60          # /api/binance/*, per client / min
# BINANCE_PROXY_GLOBAL_MAX=1200
# MARKET_MAX_SYMBOLS=50         # cap on ?symbols= list length
# MARKET_MAX_STREAMS=3          # concurrent SSE streams per client

# ─── Account lockout (optional — defaults shown) ──────────────────
# Keyed on the login address, so unlike the IP limits it cannot be
# sidestepped by rewriting a header. Applied to unknown addresses
# too, so the lockout never reveals whether an account exists.
# AUTH_FREE_ATTEMPTS=5          # failures before the first lock
# AUTH_LOCK_BASE_SECONDS=30     # first lock, doubles each failure
# AUTH_LOCK_MAX_SECONDS=900     # cap on the backoff

# ─── Logging ──────────────────────────────────────────────────────
# LOG_LEVEL=info                # debug is noisy and may echo query args

# ─── Commentary (GET /api/commentary) ─────────────────────────────
# Two sources need no credentials and are always on: publisher RSS
# feeds (CoinDesk, Cointelegraph, Decrypt, The Block, Bitcoin
# Magazine, CryptoSlate) and Yahoo Finance's per-instrument headline
# feed. Everything below is optional — each source switches itself
# on when its key is present and is skipped silently when it is not.
# GET /api/commentary/sources shows which are live.

# X (Twitter) API v2 recent search. Metered — see X's pricing.
# X_BEARER_TOKEN=""
# Restrict the search to specific handles, which is what turns this
# into a "recognised voices" panel. Without it, is:verified is used.
# X_ACCOUNTS="elonmusk,saylor,VitalikButerin"
# X_SEARCH_EXTRA="-is:retweet -is:reply lang:en"
# X_MAX_RESULTS=25

# CryptoPanic — crypto newsroom aggregator, carries community votes
# which are used as the sentiment signal when present.
# CRYPTOPANIC_TOKEN=""

# NewsAPI.org — broadest coverage, works for equities too.
# NOTE: the free tier is licensed for development only.
# NEWSAPI_KEY=""
# NEWSAPI_PAGE_SIZE=25

# YouTube Data API v3. YOUTUBE_CHANNELS narrows to curated channel
# ids (UC...), otherwise it is an open search.
# YOUTUBE_API_KEY=""
# YOUTUBE_CHANNELS=""
# YOUTUBE_MAX_RESULTS=10

# Reddit needs an OAuth app ("script" type) from
# https://www.reddit.com/prefs/apps — the anonymous JSON endpoints
# answer 403 to server traffic.
# REDDIT_CLIENT_ID=""
# REDDIT_CLIENT_SECRET=""
# REDDIT_LIMIT=25

# Caching and limits (defaults shown)
# COMMENTARY_TTL_SECONDS=600        # per-asset answer cache (5-15 min)
# COMMENTARY_FEED_TTL_SECONDS=600   # per-feed cache, shared by all assets
# COMMENTARY_MAX_ITEMS=40
# COMMENTARY_MAX_AGE_DAYS=60
# COMMENTARY_PROVIDER_TIMEOUT_MS=9000
# COMMENTARY_RATE_MAX=30            # per client / minute
# COMMENTARY_RATE_WINDOW_SECONDS=60
# COMMENTARY_RATE_GLOBAL_MAX=300

# ─── AI assistant (POST /api/chat) ────────────────────────────────
# The in-app help chat proxies to Claude. The key lives here and
# never reaches the browser: the SPA only ever calls /api/chat, and
# that route requires a logged-in user because the proxy costs money
# per call. Without a key the endpoint answers 503 and the rest of
# the API is unaffected.
ANTHROPIC_API_KEY=""

# Haiku 4.5 is the default: the assistant explains a UI it has
# already been told about, which is recall rather than reasoning.
# Point this at a larger model (e.g. claude-sonnet-5) if deeper
# questions justify the cost. Use the dated form
# (claude-haiku-4-5-20251001) only if your account requires it.
# CHAT_MODEL="claude-haiku-4-5"

# CHAT_MAX_TOKENS=1024            # a help panel, not an essay
# CHAT_HISTORY_LIMIT=12           # turns sent upstream, newest first
# CHAT_TIMEOUT_MS=60000           # fail fast; the SDK default is 10 min

# Keyed on the authenticated user id, so rotating X-Forwarded-For
# does not buy a fresh budget. The global ceiling caps what a single
# compromised account can spend.
# CHAT_RATE_MAX=15                # messages per user / minute
# CHAT_RATE_WINDOW_SECONDS=60
# CHAT_RATE_GLOBAL_MAX=300        # all users combined, per minute
