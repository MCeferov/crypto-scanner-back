# ─── Database (PostgreSQL — Neon / Supabase / Railway) ────────────
# Neon and Supabase require ?sslmode=require. Read by BOTH the server
# (src/env.ts) and the Prisma CLI (prisma.config.ts), so they can never
# disagree about which database they are talking to.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# ─── Auth ─────────────────────────────────────────────────────────
# Must be at least 32 characters — the server refuses to boot otherwise.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-to-a-random-string-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# ─── CORS ─────────────────────────────────────────────────────────
# Comma-separated allowlist of frontend origins. REQUIRED in production —
# the server refuses to boot without it, because the SPA lives on another
# origin and CORS is the only access control in front of this API.
# Local dev: leave empty to reflect any origin.
# Production: FRONTEND_URL="https://crypto-heatmap.netlify.app"
FRONTEND_URL=""

# ─── Server ───────────────────────────────────────────────────────
# Railway injects PORT automatically — do not set it there.
PORT=3000
NODE_ENV=development

# ─── Market data ──────────────────────────────────────────────────
# api.binance.com answers HTTP 451 to US and many datacenter IPs.
# data-api.binance.vision is the official public market-data host and is the
# safer choice for cloud deployments — this app only uses public endpoints.
# The Railway service must still run in an EU region.
BINANCE_API_BASE="https://data-api.binance.vision/api/v3"

# Optional — falls back to an in-process memory cache when unset.
REDIS_URL=""
# ALPHA_VANTAGE_API_KEY=""
# FMP_API_KEY=""

# ─── Proxy trust ──────────────────────────────────────────────────
# How many reverse proxies sit in front of this process. This is a
# SECURITY setting, not a formatting one: every IP-keyed control
# (rate limits, abuse logging) reads req.ip, and req.ip is derived
# from X-Forwarded-For. Set this HIGHER than the real number of
# proxies and a client can forge its own address by sending the
# header itself, which silently disables those controls.
# Railway = 1. Direct/no proxy = false. Verify after deploying, see
# README "Verifying trust proxy".
TRUST_PROXY=1

# ─── Rate limits (all optional — defaults shown) ──────────────────
# Per-client budgets are the first line; the *_GLOBAL_MAX ceilings
# are the backstop that still holds when a client rotates its IP.
# API_RATE_MAX=300              # per client / API_RATE_WINDOW_SECONDS, all /api
# API_RATE_WINDOW_SECONDS=60
# AUTH_RATE_MAX=10              # login, per client / 15 min
# AUTH_RATE_WINDOW_SECONDS=900
# AUTH_RATE_GLOBAL_MAX=600      # login, all clients combined
# SIGNUP_RATE_MAX=5             # signup, per client / 1 hour
# SIGNUP_RATE_WINDOW_SECONDS=3600
# SIGNUP_RATE_GLOBAL_MAX=100
# MARKET_RATE_MAX=120           # quote endpoints, per client / min
# KLINE_RATE_MAX=60             # kline endpoints, per client / min
# KLINE_RATE_GLOBAL_MAX=600
# BINANCE_PROXY_MAX=60          # /api/binance/*, per client / min
# BINANCE_PROXY_GLOBAL_MAX=1200
# MARKET_MAX_SYMBOLS=50         # cap on ?symbols= list length
# MARKET_MAX_STREAMS=3          # concurrent SSE streams per client

# ─── Account lockout (optional — defaults shown) ──────────────────
# Keyed on the login address, so unlike the IP limits it cannot be
# sidestepped by rewriting a header. Applied to unknown addresses
# too, so the lockout never reveals whether an account exists.
# AUTH_FREE_ATTEMPTS=5          # failures before the first lock
# AUTH_LOCK_BASE_SECONDS=30     # first lock, doubles each failure
# AUTH_LOCK_MAX_SECONDS=900     # cap on the backoff

# ─── Logging ──────────────────────────────────────────────────────
# LOG_LEVEL=info                # debug is noisy and may echo query args
